# Copy to tradovate.env and fill in. tradovate.env is git-ignored — never commit it.
# This holds your ACTUAL Tradovate login + API secret. Treat it like cash.

TRADOVATE_ENV=live
TRADOVATE_NAME=your_tradovate_username
TRADOVATE_PASSWORD=your_tradovate_password
TRADOVATE_CID=00000
TRADOVATE_SEC=your_api_secret
TRADOVATE_APP_ID=CLAURX
