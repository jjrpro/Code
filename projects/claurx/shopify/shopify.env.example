# Copy to shopify.env and fill in. shopify.env is git-ignored — never commit it.
SHOPIFY_STORE=jaurxflips

# Dev-dashboard app (the current path, post-Jan-2026). Mints a 24h token each run.
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=shpss_your_rotated_secret

# OR legacy static token from an old admin custom app (most stores no longer have this):
# SHOPIFY_TOKEN=shpat_...

LOW_STOCK_THRESHOLD=5
# API_VERSION=2025-01
