{
  "name": "credit-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first personal credit-card & credit-health monitor with a recommendation engine. Your financial data never leaves your machine.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "seed:reset": "node src/seed.js --reset",
    "digest": "node scripts/send-digest.js",
    "digest:dry": "node scripts/send-digest.js --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0"
  },
  "optionalDependencies": {
    "node-notifier": "^10.0.1"
  }
}
