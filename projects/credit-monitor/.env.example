# ─────────────────────────────────────────────────────────────────────────
# Credit Monitor — environment configuration
# Copy this file to `.env` and fill in what you need. Everything has a sane
# default, so the app runs out of the box with an empty .env (or none at all).
# NEVER commit your real .env. It is gitignored.
# ─────────────────────────────────────────────────────────────────────────

# --- Server ---------------------------------------------------------------
PORT=4600
# Bind only to localhost by default (local-first / privacy-first). Cloud hosts
# need 0.0.0.0 — but the app refuses to start on a public interface unless
# CM_PASSWORD is set (see below).
HOST=127.0.0.1

# Override where the SQLite DB + keyfile live. On a cloud host, point this at a
# persistent disk (e.g. Render disk mounted at /var/data).
# CM_DATA_DIR=/var/data

# --- Auth (required once exposed beyond localhost / cloud) -----------------
# Single password to open the app on your phone + Mac. Leave blank for
# local-only use. Pick something long. Sessions are signed cookies.
CM_PASSWORD=
# Optional: explicit secret for signing session cookies. If blank, derived from
# CM_PASSWORD (+ encryption key). Set it to force-log-out all devices on change.
CM_SESSION_SECRET=

# --- Screenshot import (Claude vision) ------------------------------------
# Lets you upload a screenshot of your accounts and have it read off balances,
# limits, due dates, etc. Get a key at console.anthropic.com. Costs a few cents
# per scan. Without it, screenshot import is disabled (manual + CSV still work).
CM_ANTHROPIC_API_KEY=
# Model used to read screenshots. Override to trade accuracy for cost, e.g.
# claude-haiku-4-5 (cheapest) or claude-sonnet-4-6.
CM_VISION_MODEL=claude-opus-4-8

# --- Encryption at rest ---------------------------------------------------
# Sensitive fields (e.g. card last-4, Plaid tokens) are encrypted with
# AES-256-GCM before being written to SQLite. Provide a 64-char hex key
# (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you leave this blank, the app auto-generates a key and stores it at
# data/.keyfile (gitignored). Keep that file safe — losing it means the
# encrypted fields can't be decrypted.
CM_ENCRYPTION_KEY=

# --- Target utilization ---------------------------------------------------
# The utilization % the recommendation engine aims for when telling you how
# much to pay before a statement closes. 9 = "ideal" (single digits).
CM_TARGET_UTILIZATION=9
# Warn when a card's statement closes within this many days AND it's over the
# yellow threshold.
CM_STATEMENT_WARN_DAYS=7

# --- Email digest (optional) ----------------------------------------------
# Leave SMTP_HOST blank to disable email entirely (the digest still prints to
# the console and the dashboard). These are standard SMTP settings; for Gmail
# use an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where digests are sent from / to.
DIGEST_FROM="Credit Monitor <no-reply@localhost>"
DIGEST_TO=admin@jjrproconsultants.com

# --- Scheduler ------------------------------------------------------------
# Built-in cron schedule for the digest job (node-cron syntax).
# Default: every day at 08:00 local time. Set CM_SCHEDULE_ENABLED=false to
# turn the in-process scheduler off (e.g. if you prefer real OS cron).
CM_SCHEDULE_ENABLED=true
CM_DIGEST_CRON=0 8 * * *
# Also send a fuller weekly summary (default: Mondays 08:05).
CM_WEEKLY_CRON=5 8 * * 1

# --- Desktop notifications ------------------------------------------------
# Requires the optional `node-notifier` dependency. Set false to silence.
CM_DESKTOP_NOTIFICATIONS=true

# --- Plaid (OPTIONAL, read-only) ------------------------------------------
# TODO(plaid): The Plaid integration is stubbed. To enable real read-only
# syncing: `npm i plaid`, set CM_PLAID_ENABLED=true, and fill these in.
# Without these the app works fully via manual entry + CSV import.
CM_PLAID_ENABLED=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
