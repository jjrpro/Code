{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 300,
            "statusMessage": "Installing project dependencies…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/Code/.claude/hooks/sync-memory.sh",
            "timeout": 60,
            "statusMessage": "Syncing notes to Obsidian repo…"
          }
        ]
      }
    ]
  }
}
